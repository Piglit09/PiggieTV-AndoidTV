<resources>
    <style name="Theme.PiggieTV" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/tv_app_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="colorPrimary">@color/tv_button</item>
        <item name="colorPrimaryDark">@color/tv_bg_start</item>
        <item name="colorAccent">@color/tv_focus_ring</item>
        <item name="android:editTextBackground">@drawable/tv_field_bg</item>
        <item name="android:buttonStyle">@style/Widget.PiggieTV.Button.Primary</item>
    </style>

    <style name="Widget.PiggieTV.Button.Primary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/tv_button_primary</item>
        <item name="android:textColor">@color/tv_text_primary</item>
        <item name="android:gravity">center</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:minHeight">@dimen/login_button_height</item>
    </style>
</resources>
