<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#B55CFF"
                android:endColor="#F04FD8" />
            <stroke android:width="2dp" android:color="#E6FFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#3DFFFFFF" />
            <stroke android:width="2dp" android:color="#BFC980FF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#F0AA4FFF"
                android:endColor="#D96A50FF" />
            <stroke android:width="1dp" android:color="#3DFFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#00000000" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
