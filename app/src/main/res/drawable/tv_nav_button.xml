<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_button_focused" />
            <stroke android:width="3dp" android:color="@color/tv_focus_ring" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_button" />
            <stroke android:width="2dp" android:color="@color/tv_button_focused" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_panel_bg" />
            <stroke android:width="1dp" android:color="@color/tv_panel_border" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
