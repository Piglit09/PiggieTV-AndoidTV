<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#5CFFFFFF" />
            <stroke android:width="2dp" android:color="#D9C980FF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#F0AA4FFF" android:endColor="#D96A50FF" />
            <stroke android:width="1dp" android:color="#3DFFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#B51C0B31" />
            <stroke android:width="1dp" android:color="#806E459A" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
