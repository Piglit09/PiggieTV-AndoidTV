<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
            <solid android:color="@color/tv_button_disabled" />
            <stroke android:width="1dp" android:color="@color/tv_panel_border" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
            <solid android:color="@color/tv_button_pressed" />
            <stroke android:width="3dp" android:color="@color/tv_focus_ring" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
            <solid android:color="@color/tv_button" />
            <stroke android:width="3dp" android:color="@color/tv_focus_ring" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
            <solid android:color="@color/tv_button" />
            <stroke android:width="1dp" android:color="@color/tv_button_focused" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
