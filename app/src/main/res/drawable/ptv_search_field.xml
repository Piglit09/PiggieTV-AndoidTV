<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ptv_glass_2_fallback" />
            <stroke android:width="1dp" android:color="@color/ptv_focus_pale" />
            <corners android:radius="@dimen/ptv_radius_control" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ptv_glass_1_fallback" />
            <stroke android:width="1dp" android:color="@color/ptv_glass_1_border" />
            <corners android:radius="@dimen/ptv_radius_control" />
        </shape>
    </item>
</selector>
