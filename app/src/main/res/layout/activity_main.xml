<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/login_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tv_login_backdrop"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="300dp"
            android:layout_height="72dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/app_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/native_login_tagline"
            android:textColor="@color/tv_text_secondary"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="@dimen/login_card_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/tv_panel_background"
            android:orientation="vertical"
            android:padding="@dimen/login_card_padding">

            <EditText
                android:id="@+id/server_input"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/tv_field_bg"
                android:hint="Jellyfin Server URL"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:nextFocusDown="@id/username_input"
                android:paddingHorizontal="18dp"
                android:textColor="@color/tv_text_primary"
                android:textColorHint="@color/tv_text_muted"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/username_input"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/tv_field_bg"
                android:hint="@string/native_login_username_hint"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="text"
                android:nextFocusDown="@id/password_input"
                android:nextFocusUp="@id/username_input"
                android:paddingHorizontal="18dp"
                android:textColor="@color/tv_text_primary"
                android:textColorHint="@color/tv_text_muted"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/password_input"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/tv_field_bg"
                android:hint="@string/native_login_password_hint"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:nextFocusDown="@id/shell_launch_button"
                android:nextFocusUp="@id/username_input"
                android:paddingHorizontal="18dp"
                android:textColor="@color/tv_text_primary"
                android:textColorHint="@color/tv_text_muted"
                android:textSize="18sp" />

            <Button
                android:id="@+id/shell_launch_button"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/tv_button_primary"
                android:nextFocusDown="@id/quick_connect_button"
                android:nextFocusUp="@id/password_input"
                android:text="@string/native_login_connect_text"
                android:textAllCaps="false"
                android:textColor="@color/tv_text_primary"
                android:textSize="18sp" />

            <Button
                android:id="@+id/quick_connect_button"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/tv_button_secondary"
                android:nextFocusDown="@id/quick_connect_button"
                android:nextFocusUp="@id/shell_launch_button"
                android:text="@string/native_login_quick_connect_text"
                android:textAllCaps="false"
                android:textColor="@color/tv_text_primary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/status_text"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textAlignment="center"
                android:textColor="@color/tv_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/native_login_server"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/tv_text_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
